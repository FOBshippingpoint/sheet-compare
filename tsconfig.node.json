{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "noEmit": true,
    "moduleDetection": "force"
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.browser.config.ts",
    "scripts/**/*.ts",
    "src/**/*.d.ts",
    "src/types/**/*.d.ts",
    "tests/**/*.ts",
    "tests/**/*.d.ts",
    "tests/**/*.svelte"
  ]
}
