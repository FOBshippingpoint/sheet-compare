{
  "name": "sheet-compare",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:frozen-table": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview",
    "fixtures": "uv run tests/fixtures/generate.py",
    "test:unit": "vitest run",
    "test:e2e": "bun run fixtures && vitest run --config vitest.browser.config.ts",
    "test": "bun run test:unit && bun run test:e2e",
    "playground": "bun scripts/playground.ts",
    "fmt": "oxfmt",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.12.3",
    "@vitest/browser-playwright": "^4.1.5",
    "daff": "^1.4.2",
    "jsdom": "^27.3.0",
    "oxfmt": "^0.48.0",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.8",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^4.0.15",
    "xlsx": "^0.18.5"
  }
}
